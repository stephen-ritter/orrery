<?xml version="1.0" encoding="UTF-8"?>
<!--
    orrery Basilisk <-> cFS link package.

    These containers cross the ZMQ link (Basilisk publishes SENSOR; the flight
    software answers with TORQUE_COMMAND; TRUTH goes to ground only). The
    SENSOR and TORQUE containers also live on the Software Bus: bsk_link
    ingests the wire frame and republishes it as BSK_LINK_SENSOR_FRAME_TLM for
    fcs_app, and forwards the BSK_LINK_TORQUE_COMMAND_TLM fcs_app publishes back
    out to the sim. They therefore carry TopicIds, and codegen/eds2cosmos emits
    ground defs for them: COSMOS watching SAT_OBC sees exactly what the onboard
    computer senses and commands. TRUTH_STATE deliberately keeps NO TopicId -
    it must never enter cFS (the two-target rule).

    Endianness is the whole point of this file. The non-EDS cFE runtime puts
    payload bytes in target-native order (x86 little-endian) and CCSDS headers in
    big-endian, so a payload container that crosses the link has to be declared
    littleEndian or the two sides disagree:

        Python (EdsLib) encode == C struct bytes == COSMOS LITTLE_ENDIAN items

    Verified against the live mission in the EdsLib spike: the same declaration
    round-trips byte-identically to struct.pack("<4dQ"). Do not "tidy" these to
    inherit ${CFE_MISSION/DATA_BYTE_ORDER}. That define is bigEndian and EdsLib
    honours it, which is precisely what broke the core-service payloads.

    Bus-struct twins: orrery_defs/inc/orrery_bus_msg.h mirrors these
    layouts as packed C; wire_audit re-checks the byte sizes on the live wire.
-->
<PackageFile xmlns="http://www.ccsds.org/schema/sois/seds">
  <Package name="BSK_LINK" shortDescription="Basilisk to cFS link frames (target-native little endian)">
    <DataTypeSet>

      <FloatDataType name="float64" shortDescription="IEEE-754 double, target-native order">
        <FloatDataEncoding sizeInBits="64" encodingAndPrecision="IEEE754_2008_double" byteOrder="littleEndian" />
        <Range>
          <PrecisionRange>double</PrecisionRange>
        </Range>
      </FloatDataType>

      <IntegerDataType name="uint64" shortDescription="64 bit unsigned, target-native order">
        <IntegerDataEncoding sizeInBits="64" encoding="unsigned" byteOrder="littleEndian" />
      </IntegerDataType>

      <IntegerDataType name="uint8" shortDescription="8 bit unsigned">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned" byteOrder="littleEndian" />
      </IntegerDataType>

      <IntegerDataType name="uint32" shortDescription="32 bit unsigned, target-native order">
        <IntegerDataEncoding sizeInBits="32" encoding="unsigned" byteOrder="littleEndian" />
      </IntegerDataType>

      <ArrayDataType dataTypeRef="float64" name="Vector3" shortDescription="3-axis body vector">
        <DimensionList>
          <Dimension size="3" />
        </DimensionList>
      </ArrayDataType>

      <ArrayDataType dataTypeRef="uint8" name="Bytes7" shortDescription="explicit filler: the wire is sequential">
        <DimensionList>
          <Dimension size="7" />
        </DimensionList>
      </ArrayDataType>

      <ArrayDataType dataTypeRef="float64" name="Quaternion" shortDescription="MRP attitude (euler axis times tan(phi/4))">
        <DimensionList>
          <Dimension size="4" />
        </DimensionList>
      </ArrayDataType>

      <ArrayDataType dataTypeRef="float64" name="Vector4" shortDescription="four-component double vector">
        <DimensionList>
          <Dimension size="4" />
        </DimensionList>
      </ArrayDataType>

      <!-- Basilisk -> cFS: what the satellite's own instruments report. -->
      <ContainerDataType name="SensorFrame" shortDescription="Onboard knowledge for one control tick">
        <EntryList>
          <Entry name="SimTimeS" type="float64" shortDescription="sim time [s]" />
          <Entry name="OmegaBnB" type="Vector3" shortDescription="body rate [rad/s]" />
          <Entry name="Frame" type="uint64" shortDescription="sim frame counter" />
        </EntryList>
      </ContainerDataType>

      <!-- Basilisk -> cFS: everything else the OBC reads off its own buses for
           one tick. The rate stays in SensorFrame - it is the control
           loop's input and gate's witness; this container is the observability
           companion, published alongside it, never gated. Wheel speeds are
           actuator feedback (a real FSW reads them from the wheel drivers),
           ST/CSS/MAG are sensor outputs: all legitimate onboard knowledge,
           which is exactly why they cross the link while navigator truth
           (TruthState, below) never does. Wheel axes fixed at three; four
           CSS units in TOML order. -->
      <ContainerDataType name="OnboardState" shortDescription="Actuator and instrument state for one sim instant">
        <EntryList>
          <Entry name="SimTimeS" type="float64" shortDescription="sim time [s]" />
          <Entry name="Frame" type="uint64" shortDescription="sim frame counter" />
          <Entry name="WheelSpeeds" type="Vector3" shortDescription="wheel speeds, body-axis-aligned set [rad/s]" />
          <Entry name="StQuatBn" type="Vector4" shortDescription="star tracker attitude quaternion, scalar-first, CASE wrt inertial" />
          <Entry name="CssCos" type="Vector4" shortDescription="CSS cosine outputs, TOML order [-]" />
          <Entry name="MagB" type="Vector3" shortDescription="measured magnetic field, body frame [T]" />
        </EntryList>
      </ContainerDataType>

      <!-- Basilisk -> cFS: the satellite's OPINION of its orbital state
           A modelled GPS receiver's fix — position and velocity with a
           declared, seeded error model, produced scenario-side because
           Basilisk core ships no receiver (the witness-gyro precedent: an
           honest sensor model in the world, never truth with a relabeled
           variable). It rides the observer path (published every tick,
           never gated, never acked) beside OnboardState, so the knowledge
           table loses its empty position/velocity rows the honest way: an
           instrument earned them. Truth keeps its own wire (TruthState) —
           the pair must differ (receiver scale) and agree (one world);
           the knowledge coverage check asserts both halves. -->
      <ContainerDataType name="NavState" shortDescription="GNSS receiver fix for one sim instant (opinion, not truth)">
        <EntryList>
          <Entry name="SimTimeS" type="float64" shortDescription="sim time [s]" />
          <Entry name="Frame" type="uint64" shortDescription="sim frame counter" />
          <Entry name="RBnN" type="Vector3" shortDescription="receiver position fix, inertial [m]" />
          <Entry name="VBnN" type="Vector3" shortDescription="receiver velocity fix, inertial [m/s]" />
        </EntryList>
      </ContainerDataType>

      <!-- Basilisk -> cFS: the satellite's OPINION of its attitude (registered exit
           part). The star tracker's OWN message (Basilisk STSensorMsgPayload:
           quaternion in, nothing else) sampled off the fitted device with the
           white-noise sigma the scenario TOML declared - so the wire says
           exactly what this hardware knows, no invented rate channel. The
           quaternion is scalar-first (rigidBodyKinematics C2EP: b[0] is the
           scalar); coverage compares it against the navigator's MRP as a rotation
           ANGLE GAP, bounded by that same declared sigma. -->
      <ContainerDataType name="AttitudeState" shortDescription="Star tracker attitude fix for one sim instant (opinion, not truth)">
        <EntryList>
          <Entry name="SimTimeS" type="float64" shortDescription="sim time [s]" />
          <Entry name="Frame" type="uint64" shortDescription="sim frame counter" />
          <Entry name="StqBn" type="Vector4" shortDescription="ST quaternion, scalar-first, of B wrt N [unit]" />
        </EntryList>
      </ContainerDataType>

      <!-- Basilisk -> cFS: knowledge derived by the camera from rendered images
           (CAM). This is a KNOWLEDGE channel, not an image pipe: the 512x512
           frame never leaves the Basilisk process; what crosses the airgap is
           the OpNav estimator's planet vector. Opinion by construction - the
           camera joins no control loop, fcs subscribes nothing, and the
           trajectory digests must print unchanged with the renderer on or off.
           The uint64 flags keep every field an 8-byte scalar, so the container
           packs to exactly 72 B with no padding question for the C twin
           (uint8 exists - StepAck's Mode - but mixes scales into the row). -->
      <ContainerDataType name="OpNavState" shortDescription="OpNav planet knowledge for one render instant (opinion, never truth)">
        <EntryList>
          <Entry name="SimTimeS" type="float64" shortDescription="sim time [s]" />
          <Entry name="Frame" type="uint64" shortDescription="sim frame counter" />
          <Entry name="RBnB" type="Vector3" shortDescription="planet vector estimate, body frame, from limb pixels [m]" />
          <Entry name="PlanetId" type="uint64" shortDescription="target body id (Basilisk celestial index)" />
          <Entry name="CameraId" type="uint64" shortDescription="source [[camera]] id" />
          <Entry name="Valid" type="uint64" shortDescription="1 while the estimator holds a valid fix" />
          <Entry name="FaultDetected" type="uint64" shortDescription="1 when the estimator has faulted the image" />
        </EntryList>
      </ContainerDataType>

      <!-- Basilisk -> cFS: the camera device's CONFIRMED state. The
           commanded view rides CAM_HK; this is the sim's side of the pair,
           sampled from the camera module's live fields each frame - the
           An early spike proved those fields are the truth (camera.cpp
           re-reads them every update, and vizInterface gates image requests
           on exactly them). uint64 fields throughout, the OpNavState law:
           64 B, no padding question for the C twin. Captured counts image
           RESPONSES received since boot: the firstPass boot stream (Basilisk
           streams 11 renders before the rate/shutter gates own the port) is
           included, as honesty demands - it is what the camera captured.
           Snapshots is the sim's side of the shutter-pulse pair: frames
           that left the shutter because the ground asked, outside the
           record cadence - CAM_HK.SnapshotCmds counts the asks, this counts
           the deliveries, and the gap between them is the defect. -->
      <ContainerDataType name="CamState" shortDescription="Camera device state for one sim instant (confirmed, not commanded)">
        <EntryList>
          <Entry name="SimTimeS" type="float64" shortDescription="sim time [s]" />
          <Entry name="Frame" type="uint64" shortDescription="sim frame counter" />
          <Entry name="CameraId" type="uint64" shortDescription="the [[camera]] this bird commands" />
          <Entry name="Shutter" type="uint64" shortDescription="shutter the sim is running (1 open): the module's own field" />
          <Entry name="RenderRateS" type="float64" shortDescription="image interval in use [s] (module nanoseconds converted)" />
          <Entry name="Captured" type="uint64" shortDescription="image responses received since boot (firstPass boot stream included)" />
          <Entry name="FramesRecorded" type="uint64" shortDescription="frames the store outlet has sent (0 until record_rate > 0)" />
          <Entry name="Snapshots" type="uint64" shortDescription="shutter-pulse frames delivered to the store (0 until a SNAP lands)" />
        </EntryList>
      </ContainerDataType>

      <!-- cFS -> Basilisk: what the flight software commands. -->
      <ContainerDataType name="TorqueCommand" shortDescription="Direct body torque for one control tick">
        <EntryList>
          <Entry name="SimTimeS" type="float64" shortDescription="sim time [s]" />
          <Entry name="TorqueSumB" type="Vector3" shortDescription="commanded body torque [N m]" />
          <Entry name="Frame" type="uint64" shortDescription="sim frame counter" />
        </EntryList>
      </ContainerDataType>

      <!-- cFS -> Basilisk: one accepted CAM_SET_CONFIG, forwarded by the cam
           app. This frame never gates and never acks: it rides the
           cmd channel as its own ZeroMQ topic, drained between ticks, and a
           dropped one shows on the ground as CAM_HK.RenderRateCmd drifting
           from CamState.RenderRateS - diagnosis by divergence, not by an
           ack the lockstep must wait on. Shutter/RenderRateS carry ground
           units; the sim door converts the seconds to the module's
           nanoseconds. RenderRateS > 0 is law on BOTH sides of the airgap:
           the vizInterface request modulo divides by it. -->
      <ContainerDataType name="CamConfig" shortDescription="Camera payload command for the sim's eye (never gated)">
        <EntryList>
          <Entry name="SimTimeS" type="float64" shortDescription="sim time at the command [s]" />
          <Entry name="Frame" type="uint64" shortDescription="sim frame the command rode" />
          <Entry name="CameraId" type="uint64" shortDescription="the [[camera]] to configure" />
          <Entry name="Shutter" type="uint64" shortDescription="1 open (request images), 0 closed" />
          <Entry name="RenderRateS" type="float64" shortDescription="image interval [s]; must be &gt; 0" />
          <Entry name="Pulse" type="uint64" shortDescription="1: deliver the NEXT capture to the store out of cadence, then restore the shutter; 0: steady config">
            <Constraints>
              <EnumeratedValueConstraint>
                <EnumerationList>
                  <Enumeration label="STEADY" value="0" />
                  <Enumeration label="PULSE" value="1" />
                </EnumerationList>
              </EnumeratedValueConstraint>
            </Constraints>
          </Entry>
        </EntryList>
      </ContainerDataType>

      <!-- cFS -> Basilisk: one tick of an accepted burn, forwarded by fcs
           while the burn is active. Like CamConfig it never gates and never
           acks - it rides the cmd channel as its own ZeroMQ topic, drained
           between ticks. Unlike torque it is apply-ONCE, never held: each
           frame buys exactly one tick of thrust, so a craft that goes silent
           mid-burn stops thrusting on the next tick. That is the safe
           direction (a lost frame is a short burn, never an endless one), and
           it makes the world's applied-impulse ledger a tick-for-tick mirror
           of the craft's forwarded-frame ledger - the bench, not the craft,
           reads the two against each other. -->
      <ContainerDataType name="BurnCommand" shortDescription="One tick of commanded thrust (apply-once, never held)">
        <EntryList>
          <Entry name="SimTimeS" type="float64" shortDescription="sim time at the command [s]" />
          <Entry name="ForceN" type="float64" shortDescription="thrust magnitude for this tick [N]" />
          <Entry name="AxisB" type="Vector3" shortDescription="unit thrust axis, body frame" />
          <Entry name="Frame" type="uint64" shortDescription="sim frame the command rode" />
          <Entry name="BurnId" type="uint64" shortDescription="ordinal of the burn this frame belongs to (matches fcs HK LastBurnId)" />
        </EntryList>
      </ContainerDataType>

      <!-- cFS -> Basilisk: lockstep barrier acknowledgement. fcs answers EVERY
           sensor frame it processes - enabled or not -
           so StepAck{N} proves "the satellite has seen frame N" and the sim
           may take step N+1. This is a link-protocol message: bus-internal
           (fcs -> bsk_link) and BEACON-EXCLUDED by codegen/eds2cosmos, so if
           it ever leaked to the ground feed COSMOS stamps it UNKNOWN - the
           absence of a def is the tripwire, not an oversight. -->
      <ContainerDataType name="StepAck" shortDescription="Lockstep ack for one processed sensor frame">
        <EntryList>
          <Entry name="SimTimeS" type="float64" shortDescription="sim time of the acked frame [s]" />
          <Entry name="Frame" type="uint64" shortDescription="acked sim frame counter" />
          <Entry name="Mode" type="uint8" shortDescription="fcs mode when acking: 0 disabled, 1 enabled">
            <Constraints>
              <EnumeratedValueConstraint>
                <EnumerationList>
                  <Enumeration label="DISABLED" value="0" />
                  <Enumeration label="ENABLED" value="1" />
                </EnumerationList>
              </EnumeratedValueConstraint>
            </Constraints>
          </Entry>
          <PaddingEntry sizeInBits="24" shortDescription="alignment padding (the model packs sequentially)" />
          <Entry name="TorquesIssued" type="uint32" shortDescription="torque commands issued so far (debug)" />
        </EntryList>
      </ContainerDataType>

      <!-- Basilisk -> ground truth stream (COSMOS target BSK_TRUTH). This is the
           simulator's own solution: it never enters cFS, so nothing here can be
           mistaken for something the satellite knows. -->
      <ContainerDataType name="TruthState" shortDescription="Ideal navigators truth at one sim instant">
        <EntryList>
          <Entry name="SimTimeS" type="float64" shortDescription="sim time [s]" />
          <Entry name="r_BN_N" type="Vector3" shortDescription="position B from N, inertial [m]" />
          <Entry name="v_BN_N" type="Vector3" shortDescription="inertial velocity of B [m/s]" />
          <Entry name="sigma_BN" type="Quaternion" shortDescription="attitude of B relative to N (MRP)" />
          <Entry name="omega_BN_B" type="Vector3" shortDescription="body rate [rad/s]" />
          <!-- The world's APPLIED ledger (Rung 1 burns): what the plant's
               thrusters were actually given, tick by tick. The craft's claim
               (fcs HK) is a different packet on a different wire, and no
               flight software reads these bytes - truth reaches only the
               ground. Counts ride float64 like every other entry here: exact
               below 2^53, and the whole truth frame stays one <18d. -->
          <Entry name="BurnImpulseAppliedNs" type="float64" shortDescription="|achieved force| x tick summed over applied ticks [N s]" />
          <Entry name="BurnTicksApplied" type="float64" shortDescription="ticks this vehicle actually thrust" />
          <Entry name="BurnTicksSaturated" type="float64" shortDescription="applied ticks the hardware could not fully deliver" />
          <Entry name="BurnId" type="float64" shortDescription="craft ordinal of the last applied burn (0: never)" />
          <!-- The fuel ledger (fuel rung). The tank is the world's physical
               stock: it drains natively as the set fires and does NOT gate
               the force (measured, bsk 2.12), so the world reads it and
               withholds what it cannot afford. A vehicle with NO declared
               tank reports NaN for the two mass rows - an absence declared,
               not a zero-filled fiction - while the two event counts are
               true zeros: a tankless plant never starved a tick. -->
          <Entry name="FuelRemainingKg" type="float64" shortDescription="tank stock at this instant [kg]; NaN when no tank is declared" />
          <Entry name="FuelSpentKg" type="float64" shortDescription="fuel the tank reported spending this flight [kg]; NaN when no tank is declared" />
          <Entry name="FuelTicksStarved" type="float64" shortDescription="ticks a burn ask met an empty tank and was withheld" />
          <Entry name="FuelTicksThrottled" type="float64" shortDescription="ticks the ask was squeezed to what the fuel could buy" />
        </EntryList>
      </ContainerDataType>

      <!-- Link CONTROL frame, not a part: what the world's manifest
           claims this vehicle is fitted with, shipped on the sensor socket
           every tick so the spacecraft can compare three views at boot -
           TOML claims (this frame), build contains (orrery_frames.h), bus
           streams (per-row decode counts). The digest is the registry's
           SEMANTICS, so a binary older than the catalog names itself instead
           of mis-decoding a frame whose layout changed. Deliberately NO
           TopicId: it is not telemetry, it is a handshake, and absence-of-def
           is the tripwire that keeps handshake bytes off the ground. -->
      <ContainerDataType name="FitManifest" shortDescription="Declared part fit for this vehicle (boot handshake)">
        <EntryList>
          <Entry name="SimTimeS" type="float64" shortDescription="sim time [s]" />
          <Entry name="Frame" type="uint64" shortDescription="sim frame counter" />
          <Entry name="DeclaredBits" type="uint32" shortDescription="fitted parts, bitmask over the generated frame table" />
          <Entry name="RegistryHash" type="uint32" shortDescription="registry semantics digest this world was started with" />
          <!-- Instance attribution. Slot k is the k-th id-carrying frame row
               in generated-table order (sim/parts.py id_rows); a bit is one
               instance: bit n is id n+1. This frame is the world's CLAIM;
               the spacecraft builds the streamed twin itself by reading each
               arriving frame's id field, and the verdict names the instance
               that stalled, not just the part. An unused slot is zero the
               same way an absent part is a cleared fit bit: nothing there
               pretends to be something. -->
          <Entry name="DeclaredIds0" type="uint32" shortDescription="instance ids claimed, id-row slot 0 (bit n is id n+1)" />
          <Entry name="DeclaredIds1" type="uint32" shortDescription="instance ids claimed, id-row slot 1; zero is no row in this slot" />
          <Entry name="DeclaredIds2" type="uint32" shortDescription="instance ids claimed, id-row slot 2; zero is no row in this slot" />
          <Entry name="DeclaredIds3" type="uint32" shortDescription="instance ids claimed, id-row slot 3; zero is no row in this slot" />
        </EntryList>
      </ContainerDataType>

      <!-- Bus wrappers: CCSDS telemetry header over the (little-endian) link payload. -->
      <ContainerDataType name="SensorFrameTlm" baseType="CFE_HDR/TelemetryHeader">
        <EntryList>
          <Entry name="Payload" type="SensorFrame" />
        </EntryList>
      </ContainerDataType>

      <ContainerDataType name="OnboardStateTlm" baseType="CFE_HDR/TelemetryHeader">
        <EntryList>
          <Entry name="Payload" type="OnboardState" />
        </EntryList>
      </ContainerDataType>

      <ContainerDataType name="NavStateTlm" baseType="CFE_HDR/TelemetryHeader">
        <EntryList>
          <Entry name="Payload" type="NavState" />
        </EntryList>
      </ContainerDataType>

      <ContainerDataType name="AttitudeStateTlm" baseType="CFE_HDR/TelemetryHeader">
        <EntryList>
          <Entry name="Payload" type="AttitudeState" />
        </EntryList>
      </ContainerDataType>

      <!-- The bus twin joins the TopicId + interface region only when the
           registry row lands (codegen/emit_frames.py renders that part; an
           unlanded container has no identity on the bus by design). -->
      <ContainerDataType name="OpNavStateTlm" baseType="CFE_HDR/TelemetryHeader">
        <EntryList>
          <Entry name="Payload" type="OpNavState" />
        </EntryList>
      </ContainerDataType>

      <ContainerDataType name="TorqueCommandTlm" baseType="CFE_HDR/TelemetryHeader">
        <EntryList>
          <Entry name="Payload" type="TorqueCommand" />
        </EntryList>
      </ContainerDataType>

      <ContainerDataType name="StepAckTlm" baseType="CFE_HDR/TelemetryHeader">
        <EntryList>
          <Entry name="Payload" type="StepAck" />
        </EntryList>
      </ContainerDataType>

      <ContainerDataType name="CamConfigTlm" baseType="CFE_HDR/TelemetryHeader">
        <EntryList>
          <Entry name="Payload" type="CamConfig" />
        </EntryList>
      </ContainerDataType>

      <ContainerDataType name="BurnCommandTlm" baseType="CFE_HDR/TelemetryHeader">
        <EntryList>
          <Entry name="Payload" type="BurnCommand" />
        </EntryList>
      </ContainerDataType>

      <!-- The commanded view rides CAM_HK; this wrapper carries the sim's
           confirmed view onto the bus through bsk_link's generic registry
           consumer (landed row "camstate"). -->
      <ContainerDataType name="CamStateTlm" baseType="CFE_HDR/TelemetryHeader">
        <EntryList>
          <Entry name="Payload" type="CamState" />
        </EntryList>
      </ContainerDataType>

      <!-- The store ledger: what bsk_link actually reassembled
           into /cf/img files, and what the vehicle's recorder does about it.
           The sim's CamState.FramesRecorded is what the outlet SENT; their
           divergence is the airgap eating frames. The capacity pair is the
           flying scenario's [[store]] row compiled into the binary
           (codegen/emit_store); State reads 0 nominal / 1 past the watermark
           / 2 at the bound / 3 no recorder declared. A file may be recycled
           only when an acknowledged transfer proved ground holds it, so
           FilesEvicted can never out-run what a pass actually delivered. -->
      <ContainerDataType name="CamStorage" shortDescription="Onboard image storage ledger">
        <EntryList>
          <Entry name="SimTimeS" type="float64" shortDescription="sim time of the newest sensor frame [s]" />
          <Entry name="Frame" type="uint64" shortDescription="sim frame counter at that stamp" />
          <Entry name="FilesStored" type="uint64" shortDescription="complete files reassembled under /cf/img since boot" />
          <Entry name="BytesStored" type="uint64" shortDescription="payload bytes across those files" />
          <Entry name="CapacityBytes" type="uint64" shortDescription="recorder volume bound [bytes], 0 with no recorder" />
          <Entry name="CapacityFiles" type="uint32" shortDescription="recorder file bound, 0 with no recorder" />
          <Entry name="FilesNow" type="uint32" shortDescription="files occupying the store right now" />
          <Entry name="UsedBytes" type="uint64" shortDescription="bytes occupying the store right now" />
          <Entry name="Generation" type="uint64" shortDescription="store mutations: files landed or were recycled" />
          <Entry name="FilesEvicted" type="uint64" shortDescription="proven-received files recycled to make room" />
          <Entry name="CapturesLost" type="uint64" shortDescription="captures refused at a full recorder" />
          <Entry name="TransfersAcked" type="uint64" shortDescription="files an acknowledged transfer proved received" />
          <Entry name="State" type="uint8" shortDescription="0 nominal, 1 near full, 2 full, 3 unclaimed" />
          <Entry name="Pad" type="Bytes7" shortDescription="explicit filler: the wire is sequential" />
        </EntryList>
      </ContainerDataType>
      <ContainerDataType name="CamStorageTlm" baseType="CFE_HDR/TelemetryHeader">
        <EntryList>
          <Entry name="Payload" type="CamStorage" />
        </EntryList>
      </ContainerDataType>

    </DataTypeSet>

    <ComponentSet>
      <Component name="Application">
        <RequiredInterfaceSet>
          <Interface name="SENSOR_FRAME_TLM" shortDescription="Software bus ingested basilisk sensor frame" type="CFE_SB/Telemetry">
            <GenericTypeMapSet>
              <GenericTypeMap name="TelemetryDataType" type="SensorFrameTlm" />
            </GenericTypeMapSet>
          </Interface>
          <Interface name="ONBOARD_STATE_TLM" shortDescription="Software bus ingested actuator and instrument state" type="CFE_SB/Telemetry">
            <GenericTypeMapSet>
              <GenericTypeMap name="TelemetryDataType" type="OnboardStateTlm" />
            </GenericTypeMapSet>
          </Interface>
          <Interface name="NAV_STATE_TLM" shortDescription="Software bus ingested GNSS receiver fix (opinion, never truth)" type="CFE_SB/Telemetry">
            <GenericTypeMapSet>
              <GenericTypeMap name="TelemetryDataType" type="NavStateTlm" />
            </GenericTypeMapSet>
          </Interface>
          <Interface name="ATTITUDE_STATE_TLM" shortDescription="Software bus ingested star tracker attitude fix (opinion, never truth)" type="CFE_SB/Telemetry">
            <GenericTypeMapSet>
              <GenericTypeMap name="TelemetryDataType" type="AttitudeStateTlm" />
            </GenericTypeMapSet>
          </Interface>
          <Interface name="OPNAV_STATE_TLM" shortDescription="Software bus ingested OpNav planet knowledge from rendered images (opinion, never truth)" type="CFE_SB/Telemetry">
            <GenericTypeMapSet>
              <GenericTypeMap name="TelemetryDataType" type="OpNavStateTlm" />
            </GenericTypeMapSet>
          </Interface>
          <Interface name="CAM_STATE_TLM" shortDescription="Software bus ingested camera device state (confirmed, never commanded)" type="CFE_SB/Telemetry">
            <GenericTypeMapSet>
              <GenericTypeMap name="TelemetryDataType" type="CamStateTlm" />
            </GenericTypeMapSet>
          </Interface>
          <Interface name="TORQUE_COMMAND_TLM" shortDescription="Software bus torque command from fcs for basilisk" type="CFE_SB/Telemetry">
            <GenericTypeMapSet>
              <GenericTypeMap name="TelemetryDataType" type="TorqueCommandTlm" />
            </GenericTypeMapSet>
          </Interface>
          <Interface name="STEP_ACK_TLM" shortDescription="Software bus lockstep step ack from fcs for basilisk (never ground)" type="CFE_SB/Telemetry">
            <GenericTypeMapSet>
              <GenericTypeMap name="TelemetryDataType" type="StepAckTlm" />
