From 907bacfa750ec469fff2a3d8db23e3ba44a2bfe4 Mon Sep 17 00:00:00 2001
From: stephen-ritter <sritter1995@gmail.com>
Date: Tue, 24 Nov 2026 10:05:22 -0600
Subject: [PATCH] Make live-stream startup patient and retryable

The startup screen gave up 0.5 s after binding its socket and closed it
permanently, so a world whose first message arrived late (headless or
service startup) could only be reached by restarting the app. Timeouts
now reopen the socket and keep waiting; the headless CLI modes
(-opNavMode, -directComm) default to waiting indefinitely, and
-messageTimeout sets the retry period in any mode. The response socket
receive is also made cancellable so stopping a silent listener no
longer blocks.
---
 .../DirectCommunicationController.cs          | 30 +++++++-
 .../Assets/Scripts/LiveStreaming/ResSocket.cs |  3 +-
 .../StartupScene/StartUpScreenManager.cs      | 77 ++++++++++++++-----
 3 files changed, 88 insertions(+), 22 deletions(-)

diff --git a/VizardUnityProject/Assets/Scripts/LiveStreaming/DirectCommunicationController.cs b/VizardUnityProject/Assets/Scripts/LiveStreaming/DirectCommunicationController.cs
index a4a326d..d917531 100644
--- a/VizardUnityProject/Assets/Scripts/LiveStreaming/DirectCommunicationController.cs
+++ b/VizardUnityProject/Assets/Scripts/LiveStreaming/DirectCommunicationController.cs
@@ -80,8 +80,11 @@ public class DirectCommunicationController : MonoBehaviour
         if (DataManager.SocketIsReceiveOnly) //Set up receive only socket
         {
             //Add only the NetMQ message types that can be handled in receive only
-            messageSubscriptions.Add("SIM_UPDATE");
-            messageSubscriptions.Add("SYNC_SETTINGS");
+            if (!messageSubscriptions.Contains("SIM_UPDATE"))
+            {
+                messageSubscriptions.Add("SIM_UPDATE");
+                messageSubscriptions.Add("SYNC_SETTINGS");
+            }
             //Create the subscription socket
             subSocket = new SubSocket(ReceiveVizMessageSubSocket, address, messageSubscriptions);
             //Start the socket
@@ -111,6 +114,29 @@ public class DirectCommunicationController : MonoBehaviour
         NetMQConfig.Cleanup();
     }
 
+    /// <summary>
+    /// Reopen the communication socket without tearing down NetMQ, so a timed-out
+    /// startup connection can be retried from within the app
+    /// </summary>
+    /// <param name="address">Socket address to connect Vizard</param>
+    /// <returns></returns>
+    public bool RebindSocket(string address)
+    {
+        if (DataManager.SocketIsReceiveOnly)
+        {
+            if (subSocket != null)
+            {
+                subSocket.Stop();
+            }
+        }
+        else if (resSocket != null)
+        {
+            resSocket.Stop();
+        }
+
+        return StartCommunication(address);
+    }
+
     /// <summary>
     /// Returns the correct response for a Basilisk request message
     /// </summary>
diff --git a/VizardUnityProject/Assets/Scripts/LiveStreaming/ResSocket.cs b/VizardUnityProject/Assets/Scripts/LiveStreaming/ResSocket.cs
index ee16c68..7319c65 100644
--- a/VizardUnityProject/Assets/Scripts/LiveStreaming/ResSocket.cs
+++ b/VizardUnityProject/Assets/Scripts/LiveStreaming/ResSocket.cs
@@ -17,6 +17,7 @@
 
  */
 
+using System;
 using System.Threading;
 using NetMQ;
 using NetMQ.Sockets;
@@ -101,7 +102,7 @@ public class ResSocket
         {
             NetMQMessage message = new NetMQMessage();
 
-            if (!server.TryReceiveMultipartMessage(ref message))
+            if (!server.TryReceiveMultipartMessage(TimeSpan.FromMilliseconds(100), ref message))
             {
                 continue;
             }
