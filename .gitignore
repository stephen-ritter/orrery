# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# generated protobuf bindings for C (generated in the docker build)
cfs_mission/**/gen/*_pb-c.*
!cfs_mission/**/gen/.gitkeep

# the pinned cFS core — fetched by scripts/fetch_cfs.sh, never committed.
# cfs_mission/cfs.lock is the fact; this directory is a local copy of it, and
# keeping it out of the tree is the point (see the lock file's header).
cfs_mission/cFS/
# licensed renderer unpack: vizard.lock pins it, scripts/get_vizard.sh fills this in
.vizard/

# cFS build outputs (mission is built inside docker)
cfs_mission/build*/
cfs_mission/**/build*/

# EdsLib runtime-database build (edslink/build.sh)
edslink/build*/
edslink/dist/

# OS/editor
.DS_Store

# scratch
*.zip
.protoc_check/
.scratch/
*.log

# the scenario's build fragment (codegen/emit_applist): it lands with the
# yard and is swept when the yard goes quiet - never a tracked fact
cfs_mission/mission/orrery_defs/mission_applist.cmake
# the scenario's recorder sizes (codegen/emit_store): same life as the
# applist fragment - landed with the yard, swept when the yard is quiet
cfs_mission/mission/orrery_defs/inc/orrery_store.h
cfs_mission/mission/last_build.log
*.gem

# local working journal: publication-scope decisions, receipts - never shipped
ROADMAP.md

# patience-build scratch: the v2.4.0 clone dotnet compiles Assembly-CSharp from
.vizard-build/
logs/
