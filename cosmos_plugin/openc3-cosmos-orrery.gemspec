# orrery COSMOS plugin gemspec — packages plugin.txt + generated cmd/tlm.
# Build inside the openc3 init container:
#   gem build /plugins/DEFAULT/orrery/openc3-cosmos-orrery.gemspec
Gem::Specification.new do |s|
  s.name = 'openc3-cosmos-orrery'
  s.summary = 'orrery satellite plugin (generated defs)'
  s.description = <<-EOF
    Fleet targets for the orrery fake satellite (SAT_CHIEF + SAT_DEPUTY);
    cmd/tlm definitions are auto-generated by codegen/eds2cosmos from the
    mission EDS - the same defs per bird, identity carried by the interface
    (MAP_TARGET). One generic gs_tcp TCP link per bird carries every CCSDS
    packet the FSW exposes.
  EOF
  s.license = 'Apache-2.0'
  s.authors = ['Stephen Ritter']
  s.homepage = 'https://example.invalid/orrery'
  s.platform = Gem::Platform::RUBY
  # VERSION=x.y.z to pin; default embeds a build timestamp so `cli load`
  # always sees an upgrade and re-runs install phases
  s.version = ENV['VERSION'] || ('0.1.0.' + Time.now.strftime('%Y%m%d%H%M%S'))
  s.files = Dir.glob('targets/**/*') + %w(plugin.txt README.md)
end
